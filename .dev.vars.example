# ローカル検証用（git には含めない）。コピーして .dev.vars にリネーム。
ADMIN_USER_1=tato
ADMIN_PASS_1=change-me-tato
ADMIN_USER_2=kakuly
ADMIN_PASS_2=change-me-kakuly
SESSION_SECRET=local-dev-secret-change-me-32chars-min
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=kakuly/babytato.link
GITHUB_BRANCH=main
# SITE ハブ iframe 用: pages:dev で /admin/login/ へ自動ログイン（127.0.0.1 / localhost のみ）
DEV_AUTO_LOGIN_USER=kakuly
# ホームお問い合わせフォーム（Resend 優先。未設定時は Webhook）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=tato <noreply@babytato.link>
CONTACT_TO_EMAIL=you@example.com
# フォールバック（Resend 未設定時のみ）
# CONTACT_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-with-your-webhook-token
