---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import Barcode from '../components/Barcode.astro';
import DiscographyGrid from '../components/DiscographyGrid.astro';
import ContactForm from '../components/ContactForm.astro';
import SocialLinkGrid from '../components/SocialLinkGrid.astro';
import VideoCarousel from '../components/VideoCarousel.astro';
import { site } from '../data/site';
import { discography, sortByDateDesc } from '../lib/discography';
import { getTatoYouTubeVideos } from '../lib/youtube';

const latestVideos = await getTatoYouTubeVideos(10);
const collabo = sortByDateDesc(discography.collabo);
const myReleases = sortByDateDesc(discography.myReleases);

const motto = 'やりたいことを、やりたいだけやる';
---

<BaseLayout home>
  <article class="poster">
    <header class="mast">
      <h1 class="mast__title">{site.name}</h1>
      <svg class="mast__ornament" viewBox="0 0 720 72" aria-hidden="true">
        <line x1="0" y1="36" x2="250" y2="36" />
        <line x1="470" y1="36" x2="720" y2="36" />
        <line x1="250" y1="36" x2="360" y2="8" />
        <line x1="360" y1="8" x2="470" y2="36" />
        <line x1="250" y1="36" x2="360" y2="64" />
        <line x1="360" y1="64" x2="470" y2="36" />
        <ellipse cx="360" cy="36" rx="78" ry="18" />
        <ellipse cx="360" cy="36" rx="48" ry="11" />
        <circle cx="360" cy="36" r="3" fill="currentColor" stroke="none" />
      </svg>
    </header>

    <section class="holo" data-holo>
      <!-- holo compositing: see docs/HOLO-COMPOSITING.md — do not restructure without reading -->
      <div class="holo__scene" aria-hidden="true">
        <div class="holo__composite">
          <img
            class="holo__field"
            src="/holo-field.png"
            alt=""
            width="1536"
            height="1024"
            decoding="async"
          />
          <img
            class="holo__illust"
            src="/tato-illust.jpg"
            alt=""
            width="2048"
            height="1152"
            decoding="async"
          />
        </div>
      </div>
      <p class="holo__kicker">official</p>
      <p class="holo__tag">{site.tagline}</p>
      <button class="holo__arrow" type="button" aria-expanded="false" aria-controls="holo-profile">
        <span aria-hidden="true">↘</span>
        <span class="visually-hidden">プロフィールを開く</span>
      </button>
      <p class="holo__bio">{site.profile.paragraphs[0]}</p>
      <div class="holo__profile" id="holo-profile">
        <p class="holo__label">profile</p>
        {
          site.profile.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
    </section>

    <section class="base">
      <h2 class="base__banner">{motto}</h2>
      <p class="base__num">729</p>
      <div class="base__frame" aria-hidden="true"></div>
      <div class="base__links">
        <SocialLinkGrid />
        <Barcode value="tato official" class="base__bar" />
      </div>
    </section>

    <section class="home-block" id="news">
      <header class="home-block__head">
        <h2 class="home-block__title">news</h2>
        <p class="home-block__kicker">updates</p>
      </header>
      <div class="home-block__body">
        <NewsList />
      </div>
    </section>

    {latestVideos.length > 0 && <VideoCarousel videos={latestVideos} />}

    <section class="home-block" id="discography">
      <header class="home-block__head">
        <h2 class="home-block__title">discography</h2>
        <p class="home-block__kicker">releases</p>
      </header>
      <div class="home-block__body">
        <div class="home-disco">
          <section class="home-disco__section">
            <h3 class="home-block__label">collabo</h3>
            <DiscographyGrid entries={collabo} emptyMessage="コラボリリースはまだありません。" />
          </section>
          <section class="home-disco__section">
            <h3 class="home-block__label">my releases</h3>
            <DiscographyGrid entries={myReleases} emptyMessage="ソロリリースはまだありません。" />
          </section>
        </div>
      </div>
    </section>

    <section class="home-block" id="contact">
      <header class="home-block__head">
        <h2 class="home-block__title">contact</h2>
        <p class="home-block__kicker">inquiry</p>
      </header>
      <div class="home-block__body home-contact">
        <p class="home-block__lead">お問い合わせは下記フォームよりご連絡ください。</p>
        <ContactForm />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  @property --mask-fade {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 100%;
  }

  @property --illust-anchor {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  @property --profile-reveal {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  .poster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    min-width: 0;
    max-width: 100%;
  }

  .mast {
    min-width: 0;
    padding: 1.1rem 1.15rem 0.35rem;
  }

  .mast__title {
    margin: 0;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
    font-family: var(--font-display);
    font-size: clamp(5.2rem, 22vw, 12rem);
    font-weight: 800;
    font-style: normal;
    line-height: 0.78;
    letter-spacing: -0.04em;
    text-align: center;
    text-transform: lowercase;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  .mast__ornament {
    display: block;
    width: min(100%, 42rem);
    height: auto;
    margin: 0.15rem auto 0.55rem;
    stroke: var(--ink);
    fill: none;
    stroke-width: 1.6;
  }

  /*
   * HOLO COMPOSITING — DO NOT CHANGE without reading docs/HOLO-COMPOSITING.md
   * 1. holo-field + JPG illust must be siblings inside .holo__composite (NOT ::before)
   * 2. Use tato-illust.jpg (black bg) + mix-blend-mode: lighten — NOT PNG-only
   * 3. Never put isolation: isolate on .holo (breaks blend with holo-field)
   * 4. .holo__composite isolation is OK — it only wraps field + illust
   */
  .holo {
    --holo-h: min(62vh, 34rem);
    --holo-content-h: calc(var(--holo-h) - 4px);
    --holo-open-duration: 0.78s;
    --holo-close-duration: 0.88s;
    --mask-fade-close-duration: 1.05s;
    --mask-fade-close-delay: 0.14s;
    --holo-open-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --holo-close-ease: cubic-bezier(0.45, 0, 0.55, 1);
    --mask-fade: 100%;
    --illust-anchor: 1;
    --profile-reveal: 0%;
    position: relative;
    min-height: var(--holo-h);
    margin: 0;
    overflow: hidden;
    border-block: 2px solid var(--line);
    border-inline: 0;
    color: #fff;
    transition:
      min-height var(--holo-close-duration) var(--holo-close-ease),
      --mask-fade var(--mask-fade-close-duration) var(--holo-close-ease) var(--mask-fade-close-delay),
      --illust-anchor var(--holo-close-duration) var(--holo-close-ease),
      --profile-reveal var(--holo-close-duration) var(--holo-close-ease);
  }

  .holo.is-open {
    --holo-open-extra: 18rem;
    --mask-fade: 28%;
    --illust-anchor: 0;
    --profile-reveal: 130%;
    min-height: calc(var(--holo-h) + var(--holo-open-extra));
    transition:
      min-height var(--holo-open-duration) var(--holo-open-ease),
      --mask-fade var(--holo-open-duration) var(--holo-open-ease),
      --illust-anchor var(--holo-open-duration) var(--holo-open-ease),
      --profile-reveal 0.86s var(--holo-open-ease) 0.18s;
  }

  .holo__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .holo__composite {
    position: absolute;
    inset: 0;
    isolation: isolate;
    container-type: inline-size;
  }

  .holo__field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .holo__illust {
    --illust-fit-h: min(var(--holo-content-h), calc(100cqw * 9 / 16));
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 0;
    transform: translateX(-50%)
      translateY(
        calc(
          var(--illust-anchor) * max(0px, var(--holo-content-h) - var(--illust-fit-h))
        )
      );
    display: block;
    width: min(100cqw, calc(var(--holo-content-h) * 16 / 9));
    height: var(--illust-fit-h);
    aspect-ratio: 16 / 9;
    object-fit: contain;
    object-position: center top;
    mix-blend-mode: lighten;
    -webkit-mask-image: linear-gradient(180deg, #000 var(--mask-fade), transparent 100%);
    mask-image: linear-gradient(180deg, #000 var(--mask-fade), transparent 100%);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  /*
   * Resize: no CSS transitions (JS sets --*-live each frame from animated min-height).
   * Closed: top-pin via --illust-anchor 0; on release anchor eases back to bottom.
   */
  .holo.is-resizing {
    transition: none;
  }

  .holo.is-resizing:not(.is-open) {
    --illust-anchor: 0;
  }

  .holo.is-resizing .holo__illust {
    --holo-content-h: var(--holo-content-h-live, calc(var(--holo-h) - 4px));
    --illust-fit-h: var(--illust-fit-h-live, min(var(--holo-content-h), calc(100cqw * 9 / 16)));
    width: var(--illust-fit-w-live, min(100cqw, calc(var(--holo-content-h) * 16 / 9)));
    height: var(--illust-fit-h-live, var(--illust-fit-h));
    transition: none;
  }

  .holo__kicker,
  .holo__tag,
  .holo__arrow,
  .holo__bio {
    position: absolute;
    z-index: 2;
  }

  .holo__kicker {
    top: 0.85rem;
    left: 0.95rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .holo__tag {
    top: 0.85rem;
    right: 0.95rem;
    margin: 0;
    max-width: 14rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .holo__arrow {
    left: 0.85rem;
    top: calc(var(--holo-h) - 3.7rem);
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 2px solid #fff;
    background: transparent;
    color: #fff;
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.35s ease, background 0.2s ease, color 0.2s ease;
  }

  .holo__arrow:hover {
    background: #fff;
    color: #111;
  }

  .holo.is-open .holo__arrow {
    transform: rotate(180deg);
  }

  .holo__bio {
    left: 4rem;
    right: 1rem;
    bottom: 1.05rem;
    margin: 0;
    max-width: 28rem;
    font-size: 0.78rem;
    line-height: 1.65;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.42s var(--holo-close-ease) 0.22s,
      visibility 0s linear 0.22s;
  }

  .holo.is-open .holo__bio {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.35s var(--holo-open-ease),
      visibility 0s linear 0.35s;
  }

  .holo__profile {
    position: relative;
    z-index: 2;
    max-width: 36rem;
    margin: 0 1.35rem 0 4rem;
    max-height: 0;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 max(0%, calc(var(--profile-reveal) - 32%)),
      transparent var(--profile-reveal)
    );
    mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 max(0%, calc(var(--profile-reveal) - 32%)),
      transparent var(--profile-reveal)
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    transition:
      max-height var(--holo-close-duration) var(--holo-close-ease),
      padding var(--holo-close-duration) var(--holo-close-ease),
      opacity var(--holo-close-duration) var(--holo-close-ease),
      visibility 0s linear var(--holo-close-duration);
  }

  .holo.is-open .holo__profile {
    max-height: 48rem;
    padding: calc(var(--holo-h) - 3.4rem) 0 2.2rem;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      max-height var(--holo-open-duration) var(--holo-open-ease),
      padding var(--holo-open-duration) var(--holo-open-ease),
      opacity 0.69s var(--holo-open-ease) 0.23s,
      visibility 0s linear 0s;
  }

  .holo__label {
    margin: 0 0 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .holo__profile p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .holo__profile p + p {
    margin-top: 1.1rem;
  }

  .base {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'banner num'
      'frame links';
    gap: 0;
    margin: 0;
    border-top: 2px solid var(--line);
  }

  .base__banner {
    grid-area: banner;
    margin: 0;
    padding: 0.9rem 1.15rem 0.75rem;
    border-right: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
    font-family: var(--font);
    font-size: clamp(1.15rem, 3.4vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.2;
    /* Solid fill — outline stroke makes CJK look like mojibake */
    color: var(--ink);
    -webkit-text-fill-color: var(--ink);
    -webkit-text-stroke: 0;
  }

  .base__num {
    grid-area: num;
    display: grid;
    place-items: center;
    margin: 0;
    min-width: 7.5rem;
    padding: 0.4rem 1rem;
    border-bottom: 2px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 10vw, 5.6rem);
    font-weight: 800;
    line-height: 0.8;
    letter-spacing: 0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
  }

  .base__frame {
    grid-area: frame;
    border-right: 2px solid var(--line);
  }

  .base__links {
    grid-area: links;
    display: grid;
    align-content: start;
    min-width: 12.5rem;
  }

  .base__links :global(.social-grid) {
    padding-bottom: 0.35rem;
  }

  .base__links :global(.base__bar) {
    width: 100%;
    height: 3.2rem;
    padding: 0.55rem 0.8rem 0.4rem;
    color: var(--ink);
  }

  .home-block {
    scroll-margin-top: 0.75rem;
    margin: 0;
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
    border-top: 2px solid var(--line);
  }

  .home-block__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
    border-bottom: 2px solid var(--line);
  }

  .home-block__title {
    margin: 0;
    min-width: 0;
    max-width: 100%;
    padding: 0.9rem 1.15rem 0.75rem;
    border-right: 2px solid var(--line);
    overflow-wrap: anywhere;
    word-break: break-word;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 3.4vw, 2rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.2;
    color: transparent;
    -webkit-text-stroke: 1.15px var(--ink);
  }

  .home-block__kicker {
    display: grid;
    place-items: center;
    margin: 0;
    min-width: 7.5rem;
    padding: 0.4rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .home-block__body {
    min-width: 0;
    max-width: 100%;
    padding: 1.25rem 1.15rem 1.7rem;
  }

  .home-block__label {
    margin: 0 0 0.85rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .home-block__lead {
    margin: 0 0 1.15rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  .home-disco {
    display: grid;
    gap: 2.2rem;
    min-width: 0;
  }

  @media (max-width: 720px) {
    .holo {
      --holo-h: 28rem;
    }

    .holo__tag {
      display: none;
    }

    .holo__bio,
    .holo__profile {
      left: 0.85rem;
      margin-left: 0.85rem;
    }

    .holo__bio {
      bottom: 0.85rem;
    }

    .holo.is-open .holo__arrow {
      left: 0.85rem;
    }

    .base {
      grid-template-columns: 1fr;
      grid-template-areas:
        'banner'
        'num'
        'links';
    }

    .base__banner {
      border-right: 0;
    }

    .base__frame {
      display: none;
    }

    .base__num {
      min-width: 0;
      justify-items: start;
      padding-left: 1.15rem;
    }

    .home-block__title {
      border-right: 0;
    }

    .home-block__kicker {
      min-width: 0;
      justify-items: start;
      padding-left: 1.15rem;
      border-top: 2px solid var(--line);
    }

    .home-block__head {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .holo,
    .holo__scene,
    .holo__illust,
    .holo.is-resizing .holo__illust,
    .holo__arrow,
    .holo__bio,
    .holo__profile {
      transition: none;
    }

    .holo.is-open {
      --mask-fade: 28%;
      --illust-anchor: 0;
      --profile-reveal: 130%;
    }

    .holo:not(.is-open) .holo__profile {
      max-height: 0;
      padding: 0;
      opacity: 0;
      visibility: hidden;
    }

    .holo.is-open .holo__profile {
      max-height: none;
      padding: calc(var(--holo-h) - 3.4rem) 0 2.2rem;
      opacity: 1;
      visibility: visible;
    }

    .holo.is-open .holo__bio {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>

<script is:inline>
  (function () {
    var holo = document.querySelector('[data-holo]');
    var btn = document.querySelector('.holo__arrow');
    if (!holo || !btn) return;

    var label = btn.querySelector('.visually-hidden');
    var illust = holo.querySelector('.holo__illust');
    var COOLDOWN_MS = 750;
    var resizeTimer;
    var resizeRaf = 0;

    function holoResizeSmoothMs() {
      var styles = getComputedStyle(holo);
      var prop = holo.classList.contains('is-open')
        ? '--holo-open-duration'
        : '--holo-close-duration';
      var seconds = parseFloat(styles.getPropertyValue(prop));
      return (Number.isFinite(seconds) ? seconds : 0.88) * 1000;
    }

    function parseLengthPx(value, rootPx) {
      var n = parseFloat(value);
      if (!Number.isFinite(n)) return 0;
      if (String(value).indexOf('rem') !== -1) return n * rootPx;
      return n;
    }

    function syncIllustSizing() {
      if (!holo.classList.contains('is-resizing') || !illust) return;
      var holoStyles = getComputedStyle(holo);
      var rootPx = parseFloat(getComputedStyle(document.documentElement).fontSize);
      var framePx = parseLengthPx(holoStyles.minHeight, rootPx);
      if (holo.classList.contains('is-open')) {
        var extra = holoStyles.getPropertyValue('--holo-open-extra').trim() || '18rem';
        framePx -= parseLengthPx(extra, rootPx);
      }
      if (framePx > 0) {
        var composite = holo.querySelector('.holo__composite');
        var frameW = composite ? composite.clientWidth : holo.clientWidth;
        var contentPx = Math.max(0, framePx - 4);
        var fitH = Math.min(contentPx, frameW * 9 / 16);
        var fitW = Math.min(frameW, contentPx * 16 / 9);
        holo.style.setProperty('--holo-content-h-live', contentPx + 'px');
        holo.style.setProperty('--illust-fit-h-live', fitH + 'px');
        holo.style.setProperty('--illust-fit-w-live', fitW + 'px');
      }
      resizeRaf = requestAnimationFrame(syncIllustSizing);
    }

    function clearLiveSizing() {
      holo.style.removeProperty('--holo-content-h-live');
      holo.style.removeProperty('--illust-fit-h-live');
      holo.style.removeProperty('--illust-fit-w-live');
    }

    function stopResizeSync() {
      holo.classList.remove('is-resizing');
      if (resizeRaf) {
        cancelAnimationFrame(resizeRaf);
        resizeRaf = 0;
      }
      requestAnimationFrame(clearLiveSizing);
    }

    function beginResizeSync() {
      holo.classList.add('is-resizing');
      if (!resizeRaf) resizeRaf = requestAnimationFrame(syncIllustSizing);
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(stopResizeSync, holoResizeSmoothMs());
    }

    window.addEventListener('resize', beginResizeSync);

    btn.addEventListener('click', function () {
      if (btn.disabled) return;

      btn.disabled = true;
      btn.setAttribute('aria-disabled', 'true');

      var open = holo.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (label) label.textContent = open ? 'プロフィールを閉じる' : 'プロフィールを開く';

      setTimeout(function () {
        btn.disabled = false;
        btn.removeAttribute('aria-disabled');
      }, COOLDOWN_MS);
    });
  })();
</script>

