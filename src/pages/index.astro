---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const allNews = (await getCollection('news'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allWorks = (await getCollection('works')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const latestNews = allNews.slice(0, 2);
const featuredWorks = allWorks.filter((work) => work.data.featured).slice(0, 2);
---

<BaseLayout>
  <section class="hero bubble-card">
    <div class="hero__content">
      <p class="hero__eyebrow">{site.tagline}</p>
      <h1 class="hero__title">
        <span class="hero__emoji" aria-hidden="true">{site.heroEmoji}</span>
        {site.name}
      </h1>
      <p class="hero__lead">{site.profile.bio}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/works/">作品を見る</a>
        <a class="btn btn--secondary" href="/links/">リンク集</a>
      </div>
    </div>
    <div class="hero__avatar-wrap">
      <img class="hero__avatar" src={site.profile.avatar} alt={`${site.name} のアバター`} width="220" height="220" />
      <span class="hero__sparkle hero__sparkle--1" aria-hidden="true">✨</span>
      <span class="hero__sparkle hero__sparkle--2" aria-hidden="true">⭐</span>
      <span class="hero__sparkle hero__sparkle--3" aria-hidden="true">💫</span>
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2 class="section-title">📢 最新のお知らせ</h2>
      <a class="section__more" href="/news/">すべて見る →</a>
    </div>
    <div class="grid-2">
      {latestNews.map((entry) => <NewsCard entry={entry} />)}
    </div>
  </section>

  <section class="section">
    <div class="section__head">
      <h2 class="section-title">🎵 ピックアップ作品</h2>
      <a class="section__more" href="/works/">すべて見る →</a>
    </div>
    <div class="grid-2">
      {featuredWorks.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 2rem;
    align-items: center;
    margin-bottom: 3rem;
    padding: 2rem;
    background: linear-gradient(135deg, var(--pop-blue), var(--pop-pink));
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }

  .hero__eyebrow {
    margin: 0 0 0.5rem;
    font-weight: 700;
  }

  .hero__title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
  }

  .hero__emoji {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 3px solid var(--pop-border);
    border-radius: 50%;
    background: var(--pop-yellow);
    box-shadow: var(--shadow-pop);
  }

  .hero__lead {
    margin: 1rem 0 0;
    max-width: 34rem;
    font-size: 1.05rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    border: 3px solid var(--pop-border);
    border-radius: var(--radius-pill);
    text-decoration: none;
    font-weight: 800;
    box-shadow: var(--shadow-pop);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-pop-hover);
  }

  .btn--primary {
    background: var(--pop-yellow);
  }

  .btn--secondary {
    background: var(--pop-white);
  }

  .hero__avatar-wrap {
    position: relative;
    justify-self: center;
  }

  .hero__avatar {
    width: min(100%, 220px);
    aspect-ratio: 1;
    border: 4px solid var(--pop-border);
    border-radius: 50%;
    background: var(--pop-white);
    box-shadow: var(--shadow-pop);
    object-fit: cover;
  }

  .hero__sparkle {
    position: absolute;
    font-size: 1.5rem;
    animation: float 3s ease-in-out infinite;
  }

  .hero__sparkle--1 { top: 0; right: 0; }
  .hero__sparkle--2 { bottom: 10%; left: -5%; animation-delay: 0.5s; }
  .hero__sparkle--3 { top: 20%; left: -10%; animation-delay: 1s; }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .section {
    margin-bottom: 3rem;
  }

  .section__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section__more {
    font-weight: 700;
    color: var(--pop-purple);
    text-decoration: none;
  }
</style>
