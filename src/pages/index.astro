---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsItem from '../components/NewsItem.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { links } from '../data/links';

const newsEntries = (await getCollection('news'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout>
  <section class="intro">
    <h1 class="intro__name">{site.name}</h1>
    <p class="intro__tagline">{site.tagline}</p>
    <p class="intro__bio">{site.profile.paragraphs[0]}</p>
  </section>

  <section class="section">
    <h2 class="section-label">news</h2>
    {
      newsEntries.length > 0 ? (
        <ul class="list-plain">
          {newsEntries.map((entry) => (
            <NewsItem entry={entry} />
          ))}
        </ul>
      ) : (
        <p class="empty">お知らせはまだありません。</p>
      )
    }
  </section>

  <section class="section">
    <h2 class="section-label">links</h2>
    <ul class="list-plain links">
      {
        links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .intro__name {
    margin: 0;
    font-size: clamp(2rem, 8vw, 2.75rem);
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: lowercase;
  }

  .intro__tagline {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: lowercase;
  }

  .intro__bio {
    margin: 2.5rem 0 0;
    max-width: 32rem;
    font-size: 0.95rem;
  }

  .links > li + li {
    margin-top: 0.75rem;
    padding-top: 0;
    border-top: none;
  }

  .links a {
    font-size: 0.95rem;
    text-decoration: none;
    letter-spacing: 0.06em;
  }
</style>
