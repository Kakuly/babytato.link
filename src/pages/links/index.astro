---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkButton from '../../components/LinkButton.astro';
import { linkCategories } from '../../data/links';
---

<BaseLayout title="Links" description="BabyTato の SNS・配信・関連リンク集">
  <header class="page-header">
    <h1 class="page-title">🔗 Links</h1>
    <p class="page-lead">SNS、動画、音源、お問い合わせなどのリンク集です。</p>
  </header>

  <div class="links-page">
    {
      linkCategories.map((category) => (
        <section class="links-section bubble-card">
          <h2 class="links-section__title">
            <span aria-hidden="true">{category.emoji}</span>
            {category.title}
          </h2>
          <div class="links-section__list">
            {category.items.map((item) => (
              <LinkButton
                label={item.label}
                url={item.url}
                description={item.description}
                emoji={item.emoji}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .links-page {
    display: grid;
    gap: 1.5rem;
  }

  .links-section {
    padding: 1.5rem;
    background: var(--pop-white);
  }

  .links-section__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 1.35rem;
    font-weight: 800;
  }

  .links-section__list {
    display: grid;
    gap: 0.85rem;
  }
</style>
