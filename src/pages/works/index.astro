---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DiscographyGrid from '../../components/DiscographyGrid.astro';
import { discography, sortByDateDesc } from '../../lib/discography';

const collabo = sortByDateDesc(discography.collabo);
const myReleases = sortByDateDesc(discography.myReleases);
---

<BaseLayout title="discography" description="tato のディスコグラフィー。">
  <h1 class="page-title">discography</h1>
  <p class="page-lead">コラボレーションとソロリリースを掲載しています。</p>

  <section class="discography-section">
    <h2 class="discography-section__title">collabo</h2>
    <DiscographyGrid entries={collabo} emptyMessage="コラボリリースはまだありません。" />
  </section>

  <section class="discography-section">
    <h2 class="discography-section__title">my releases</h2>
    <DiscographyGrid entries={myReleases} emptyMessage="ソロリリースはまだありません。" />
  </section>
</BaseLayout>

<style>
  .discography-section {
    margin-top: 2rem;
  }

  .discography-section + .discography-section {
    margin-top: 2.5rem;
  }

  .discography-section__title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
