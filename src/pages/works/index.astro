---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkItem from '../../components/WorkItem.astro';
import { getYouTubeVideos } from '../../lib/youtube';

const videos = await getYouTubeVideos();
---

<BaseLayout title="discography" description="tato のディスコグラフィー。">
  <h1 class="page-title">discography</h1>
  <p class="page-lead">YouTube に公開された動画を自動で取得しています。</p>

  {
    videos.length > 0 ? (
      <ul class="list-plain section">
        {videos.map((video) => (
          <WorkItem video={video} />
        ))}
      </ul>
    ) : (
      <p class="empty section">作品を取得できませんでした。</p>
    )
  }
</BaseLayout>

<style>
  .section {
    margin-top: 1.75rem;
  }
</style>
