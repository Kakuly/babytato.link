---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { adminDashboardPath } from "../../../lib/admin-paths";
---

<AdminLayout title="discography">
  <section class="admin-card">
    <p class="admin-back">
      <a class="admin-btn" href={adminDashboardPath()}>←戻る</a>
    </p>
    <h2 class="admin-card-title">discography</h2>
    <p class="admin-hint">
      collabo / my releases を編集します。ジャケットは GitHub の <code>public/releases/</code> に保存され、一覧は
      <code>discography.json</code> に commit されます。
    </p>

    <div class="admin-tabs" role="tablist" aria-label="discography sections">
      <button type="button" class="admin-tab is-active" data-disco-tab="collabo" role="tab" aria-selected="true">
        collabo
      </button>
      <button type="button" class="admin-tab" data-disco-tab="myReleases" role="tab" aria-selected="false">
        my releases
      </button>
    </div>

    <div class="admin-actions admin-actions--inline">
      <button type="button" class="admin-btn admin-btn-primary" id="disco-add">add release</button>
      <button type="button" class="admin-btn" id="disco-reload">reload</button>
    </div>

    <p id="disco-loading" class="admin-loading">loading…</p>
    <ul id="disco-list" class="admin-disco-list" hidden></ul>
    <p id="disco-empty" class="admin-hint" hidden>リリースはまだありません。</p>

    <div id="disco-form-wrap" class="admin-disco-form-wrap" hidden>
      <h3 class="admin-card-title" id="disco-form-heading">new release</h3>
      <form id="disco-form" class="admin-grid">
        <div class="admin-disco-preview-row">
          <div class="admin-disco-preview">
            <img id="disco-preview" alt="" hidden />
            <span id="disco-preview-empty" class="admin-disco-preview__empty">no jacket</span>
          </div>
          <div class="admin-field">
            <label for="disco-file">jacket</label>
            <input id="disco-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
            <p class="admin-hint">JPEG / PNG / WebP / GIF · 10MB 以下</p>
          </div>
        </div>

        <div class="admin-field">
          <label for="disco-title">title</label>
          <input id="disco-title" name="title" type="text" required autocomplete="off" />
        </div>

        <div class="admin-field">
          <label for="disco-id">id</label>
          <input id="disco-id" name="id" type="text" required autocomplete="off" spellcheck="false" />
        </div>

        <div class="admin-field">
          <label for="disco-type">type</label>
          <select id="disco-type" name="type" required>
            <option value="single">single</option>
            <option value="ep">ep</option>
            <option value="album">album</option>
          </select>
        </div>

        <div class="admin-field">
          <label for="disco-date">date</label>
          <input id="disco-date" name="date" type="date" />
        </div>

        <div class="admin-field">
          <label for="disco-url">url</label>
          <input id="disco-url" name="url" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://" />
        </div>

        <div class="admin-actions">
          <button type="submit" class="admin-btn admin-btn-primary" id="disco-save">save</button>
          <button type="button" class="admin-btn" id="disco-cancel">cancel</button>
        </div>
      </form>
    </div>

    <p id="disco-status" class="admin-status" aria-live="polite"></p>
  </section>
</AdminLayout>

<script>
  import { initDiscographyEditor } from "../../../scripts/admin/discography";

  initDiscographyEditor().catch(() => undefined);
</script>

<style>
  .admin-hint code {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .admin-actions--inline {
    margin-top: 0;
    margin-bottom: var(--space-3);
  }

  .admin-disco-preview-row .admin-hint {
    margin: 0;
  }
</style>
