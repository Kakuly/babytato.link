---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="About" description={`${site.name} のプロフィール`}>
  <header class="page-header">
    <h1 class="page-title">✨ About</h1>
    <p class="page-lead">プロフィールと活動について。</p>
  </header>

  <section class="about bubble-card">
    <div class="about__profile">
      <img
        class="about__avatar"
        src={site.profile.avatar}
        alt={`${site.name} のプロフィール画像`}
        width="180"
        height="180"
      />
      <div>
        <h2 class="about__name">{site.profile.name}</h2>
        <p class="about__bio">{site.profile.bio}</p>
      </div>
    </div>

    <div class="about__details">
      <div class="about__block">
        <h3>🎤 活動内容</h3>
        <p>歌ってみた動画、オリジナル曲、ライブ配信などを中心に活動しています。</p>
      </div>
      <div class="about__block">
        <h3>💡 好きなこと</h3>
        <p>ポップで明るい曲、可愛いビジュアル、みんなと一緒に盛り上がるライブ。</p>
      </div>
      <div class="about__block">
        <h3>📬 お仕事</h3>
        <p>
          コラボ・イベント出演などのお問い合わせは
          <a href="/links/">Links ページ</a>
          からどうぞ。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding: 2rem;
    background: linear-gradient(180deg, var(--pop-white), var(--pop-bg-alt));
  }

  .about__profile {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .about__profile {
      grid-template-columns: auto 1fr;
    }
  }

  .about__avatar {
    width: 180px;
    aspect-ratio: 1;
    border: 4px solid var(--pop-border);
    border-radius: 50%;
    background: var(--pop-yellow);
    box-shadow: var(--shadow-pop);
    object-fit: cover;
  }

  .about__name {
    margin: 0 0 0.5rem;
    font-size: 2rem;
    font-weight: 800;
  }

  .about__bio {
    margin: 0;
    color: var(--pop-muted);
    font-size: 1.05rem;
  }

  .about__details {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .about__details {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .about__block {
    padding: 1rem;
    border: 2px dashed rgb(45 27 78 / 18%);
    border-radius: 1rem;
    background: rgb(255 255 255 / 70%);
  }

  .about__block h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .about__block p {
    margin: 0;
    color: var(--pop-muted);
  }

  .about__block a {
    color: var(--pop-purple);
    font-weight: 700;
  }
</style>
