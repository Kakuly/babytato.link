---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="contact" description="tato へのお問い合わせ。">
  <h1 class="page-title">contact</h1>
  <p class="page-lead">お問い合わせ · 送信機能は未接続</p>

  <form class="contact section" action="#" method="post">
    <div class="contact__field">
      <label for="contact-name">name</label>
      <input id="contact-name" name="name" type="text" required autocomplete="name" />
    </div>

    <div class="contact__field">
      <label for="contact-email">email</label>
      <input id="contact-email" name="email" type="email" required autocomplete="email" />
    </div>

    <div class="contact__field">
      <label for="contact-subject">
        subject <span class="contact__optional">optional</span>
      </label>
      <input id="contact-subject" name="subject" type="text" autocomplete="off" />
    </div>

    <div class="contact__field">
      <label for="contact-message">message</label>
      <textarea id="contact-message" name="message" rows="6" required></textarea>
    </div>

    <button type="submit" class="contact__submit">send</button>
  </form>
</BaseLayout>

<style>
  .contact {
    border: 2px solid var(--line);
    padding: 1.35rem 1.2rem 1.5rem;
    max-width: 32rem;
  }

  .contact__field + .contact__field {
    margin-top: 1.25rem;
  }

  .contact__field label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .contact__optional {
    color: var(--muted);
    text-transform: lowercase;
    letter-spacing: 0.08em;
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    padding: 0.65rem 0.75rem;
    border: 2px solid var(--line);
    background: var(--void);
    color: var(--ink);
    font-family: var(--font);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .contact__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact__submit {
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    border: 2px solid var(--line);
    background: var(--ink);
    color: var(--void);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .contact__submit:hover {
    background: var(--void);
    color: var(--ink);
  }
</style>
