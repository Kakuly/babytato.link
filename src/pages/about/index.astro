---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout title="about" description="tato について。">
  <h1 class="page-title">about</h1>

  <div class="about section">
    {
      site.profile.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))
    }

    <p class="about__links">
      <a href={site.social.x} target="_blank" rel="noopener noreferrer">X</a>
      ·
      <a href={site.social.youtube} target="_blank" rel="noopener noreferrer">tato youtube</a>
      ·
      <a href={site.social.nocffieYoutube} target="_blank" rel="noopener noreferrer">nocffie youtube</a>
    </p>
  </div>
</BaseLayout>

<style>
  .section {
    margin-top: 3rem;
  }

  .about p {
    margin: 0;
    font-size: 0.95rem;
  }

  .about p + p {
    margin-top: 1.5rem;
  }

  .about__links {
    margin-top: 2.5rem !important;
    color: var(--color-muted);
    font-size: 0.85rem !important;
    letter-spacing: 0.06em;
  }

  .about__links a {
    text-decoration: none;
  }
</style>
