---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = site.description, home = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.tagline}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'is-home': home }}>
    <div class="shell">
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  body {
    padding: var(--frame);
  }

  .shell {
    min-height: calc(100vh - var(--frame) * 2);
    border: 2px solid var(--line);
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  body.is-home {
    --max-width: none;
    padding: 0;
    overflow-x: clip;
  }

  body.is-home .shell {
    border: 0;
    min-height: 100vh;
  }

  body.is-home main {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>
