---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <p>&copy; {year} {site.name}</p>
</footer>

<style>
  .footer {
    width: min(calc(100% - 2.5rem), var(--max-width));
    margin: 0 auto;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .footer p {
    margin: 0;
  }
</style>
