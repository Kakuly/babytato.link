---
import type { YouTubeVideo } from '../lib/youtube';

interface Props {
  videos: YouTubeVideo[];
}

const { videos } = Astro.props;

const visibleCount = 3;
const headClones = videos.slice(-visibleCount);
const tailClones = videos.slice(0, visibleCount);
const trackVideos = [...headClones, ...videos, ...tailClones];
---

<section
  class="video-carousel"
  aria-label="最新動画"
  data-video-carousel
  data-total={videos.length}
  data-visible={visibleCount}
>
  <div class="video-carousel__viewport">
    <div class="video-carousel__track" data-track>
      {
        trackVideos.map((video) => (
          <a
            class="video-carousel__item"
            href={video.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              src={video.thumbnailUrl}
              alt={video.title}
              width="1280"
              height="720"
              loading="lazy"
              decoding="async"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .video-carousel {
    margin: 0;
    border-top: 2px solid var(--line);
    overflow: hidden;
  }

  .video-carousel__viewport {
    overflow: hidden;
    width: 100%;
    cursor: grab;
    touch-action: pan-y;
  }

  .video-carousel.is-grabbing .video-carousel__viewport {
    cursor: grabbing;
  }

  .video-carousel.is-grabbing {
    user-select: none;
  }

  .video-carousel.is-grabbing .video-carousel__item {
    pointer-events: none;
  }

  .video-carousel__track {
    display: flex;
    gap: 0;
    will-change: transform;
    transition: transform 0.45s cubic-bezier(0.45, 0.05, 0.25, 1);
  }

  .video-carousel__track.is-resetting {
    transition: none;
  }

  .video-carousel__item {
    display: block;
    flex: 0 0 auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    line-height: 0;
  }

  .video-carousel__item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.2s ease;
  }

  .video-carousel__item:hover img {
    opacity: 0.82;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-carousel__track {
      transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    }
  }
</style>

<script>
  function initVideoCarousel(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>('.video-carousel__viewport');
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!viewport || !track) return;

    const total = Number(root.dataset.total ?? 0);
    const visible = Number(root.dataset.visible ?? 3);
    if (total <= visible) return;

    const items = track.querySelectorAll<HTMLElement>('.video-carousel__item');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const secondsPerItem = 5.5;
    const slideDurationMs = prefersReducedMotion ? 650 : 1_300;
    const dwellDurationMs = secondsPerItem * 1_000 - slideDurationMs;
    const snapDurationMs = 450;
    const dragThreshold = 8;
    const resumeDelayMs = 1_500;

    let offsetPx: number | null = null;
    let itemWidth = 0;
    let paused = false;
    let animating = false;

    let autoScrollTimer: ReturnType<typeof setTimeout> | undefined;
    let resumeTimer: ReturnType<typeof setTimeout> | undefined;

    let isDragging = false;
    let dragStartX = 0;
    let dragStartOffset = 0;
    let dragDelta = 0;
    let hasDragged = false;
    let suppressClick = false;

    function baseOffset() {
      return visible * itemWidth;
    }

    function loopSpan() {
      return total * itemWidth;
    }

    function maxDragOffset() {
      return (visible + total) * itemWidth;
    }

    function normalizeOffset(px: number) {
      const base = baseOffset();
      const span = loopSpan();
      if (span <= 0) return px;

      if (px >= base + span) {
        return px - span;
      }

      if (px < base) {
        return px + span;
      }

      return px;
    }

    function clampDragOffset(px: number) {
      return Math.max(0, Math.min(px, maxDragOffset()));
    }

    function setTransform(px: number, animate: boolean, durationMs = snapDurationMs) {
      animating = animate;
      track.classList.toggle('is-resetting', !animate);
      if (animate) {
        track.style.transition = `transform ${durationMs}ms cubic-bezier(0.45, 0.05, 0.25, 1)`;
      } else {
        track.style.transition = '';
      }
      track.style.transform = `translate3d(-${px}px, 0, 0)`;
    }

    function layout() {
      const viewportWidth = root.clientWidth;
      const newItemWidth = viewportWidth / visible;

      if (offsetPx === null) {
        offsetPx = visible * newItemWidth;
      } else if (itemWidth > 0) {
        offsetPx = normalizeOffset((offsetPx / itemWidth) * newItemWidth);
      }

      itemWidth = newItemWidth;

      items.forEach((item) => {
        item.style.width = `${itemWidth}px`;
      });

      setTransform(offsetPx, false);
    }

    function scheduleDwell() {
      if (autoScrollTimer || paused || isDragging) return;
      autoScrollTimer = window.setTimeout(() => {
        autoScrollTimer = undefined;
        advanceGlide();
      }, dwellDurationMs);
    }

    function advanceGlide() {
      if (paused || isDragging || offsetPx === null || itemWidth <= 0) {
        scheduleDwell();
        return;
      }

      offsetPx += itemWidth;
      setTransform(offsetPx, true, slideDurationMs);

      autoScrollTimer = window.setTimeout(() => {
        autoScrollTimer = undefined;
        if (offsetPx !== null) {
          const normalized = normalizeOffset(offsetPx);
          if (normalized !== offsetPx) {
            offsetPx = normalized;
            setTransform(offsetPx, false);
          }
        }
        animating = false;
        scheduleDwell();
      }, slideDurationMs);
    }

    function startAutoScroll() {
      scheduleDwell();
    }

    function stopAutoScroll() {
      if (!autoScrollTimer) return;
      window.clearTimeout(autoScrollTimer);
      autoScrollTimer = undefined;
    }

    function scheduleResume() {
      if (resumeTimer) window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        resumeTimer = undefined;
        startAutoScroll();
      }, resumeDelayMs);
    }

    function snapAfterDrag() {
      const rawOffset = dragStartOffset - dragDelta;
      const clampedOffset = clampDragOffset(rawOffset);
      const snappedIndex = Math.round(clampedOffset / itemWidth);
      offsetPx = snappedIndex * itemWidth;

      setTransform(offsetPx, true);

      window.setTimeout(() => {
        if (offsetPx !== null) {
          const normalized = normalizeOffset(offsetPx);
          if (normalized !== offsetPx) {
            offsetPx = normalized;
            setTransform(offsetPx, false);
          }
        }
        animating = false;
      }, snapDurationMs);
    }

    function onPointerDown(event: PointerEvent) {
      if (event.button !== 0) return;

      isDragging = true;
      hasDragged = false;
      dragStartX = event.clientX;
      dragStartOffset = offsetPx;
      dragDelta = 0;
      animating = false;

      stopAutoScroll();
      if (resumeTimer) {
        window.clearTimeout(resumeTimer);
        resumeTimer = undefined;
      }

      root.classList.add('is-grabbing');
      track.classList.add('is-resetting');
      viewport.setPointerCapture(event.pointerId);
    }

    function onPointerMove(event: PointerEvent) {
      if (!isDragging) return;

      dragDelta = event.clientX - dragStartX;
      if (Math.abs(dragDelta) > dragThreshold) {
        hasDragged = true;
      }

      const rawOffset = dragStartOffset - dragDelta;
      track.style.transform = `translate3d(-${clampDragOffset(rawOffset)}px, 0, 0)`;
    }

    function onPointerUp(event: PointerEvent) {
      if (!isDragging) return;

      isDragging = false;
      root.classList.remove('is-grabbing');
      viewport.releasePointerCapture(event.pointerId);

      if (hasDragged) {
        suppressClick = true;
        snapAfterDrag();
        window.setTimeout(() => {
          suppressClick = false;
        }, 0);
      } else if (offsetPx !== null) {
        setTransform(offsetPx, false);
      }

      scheduleResume();
    }

    layout();
    startAutoScroll();

    viewport.addEventListener('pointerdown', onPointerDown);
    viewport.addEventListener('pointermove', onPointerMove);
    viewport.addEventListener('pointerup', onPointerUp);
    viewport.addEventListener('pointercancel', onPointerUp);

    track.addEventListener(
      'click',
      (event) => {
        if (suppressClick) {
          event.preventDefault();
          event.stopPropagation();
        }
      },
      true,
    );

    viewport.addEventListener('mouseenter', () => {
      paused = true;
      stopAutoScroll();
      if (resumeTimer) {
        window.clearTimeout(resumeTimer);
        resumeTimer = undefined;
      }
    });

    viewport.addEventListener('mouseleave', () => {
      paused = false;
      if (!isDragging) {
        startAutoScroll();
      }
    });

    window.addEventListener('resize', layout);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoScroll();
      } else if (!isDragging && !paused) {
        startAutoScroll();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-video-carousel]').forEach(initVideoCarousel);
</script>
