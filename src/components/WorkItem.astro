---
import type { YouTubeVideo } from '../lib/youtube';

interface Props {
  video: YouTubeVideo;
}

const { video } = Astro.props;

const formattedDate = video.published.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<li class="work">
  <div class="work__main">
    <a class="work__title" href={video.url} target="_blank" rel="noopener noreferrer">
      {video.title}
    </a>
    <p class="meta">
      {formattedDate}
      <span class="work__sep">/</span>
      {video.sourceLabel}
    </p>
  </div>
</li>

<style>
  .work {
    border: 2px solid var(--line);
  }

  .work + .work {
    margin-top: -2px;
  }

  .work__main {
    padding: 0.95rem 1rem;
  }

  .work:hover {
    background: var(--ink);
    color: var(--void);
  }

  .work__title {
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .work:hover .work__title,
  .work:hover .meta {
    color: var(--void);
  }

  .work__sep {
    margin: 0 0.35rem;
  }

  .meta {
    margin: 0.3rem 0 0;
  }
</style>
