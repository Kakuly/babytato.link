---
import type { DiscographyEntry } from '../lib/discography';

interface Props {
  entries: DiscographyEntry[];
  emptyMessage?: string;
}

const { entries, emptyMessage = 'リリースはまだありません。' } = Astro.props;
---

{
  entries.length > 0 ? (
    <div class="discography-grid">
      {entries.map((entry) => {
        const Tag = entry.url ? 'a' : 'div';
        const linkProps = entry.url
          ? {
              href: entry.url,
              target: '_blank',
              rel: 'noopener noreferrer',
            }
          : {};

        return (
          <Tag class="discography-grid__item" {...linkProps} title={entry.title}>
            <span class="discography-grid__art">
              <img
                class="discography-grid__img"
                src={entry.img}
                alt={entry.title}
                width="480"
                height="480"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="discography-grid__meta">
              <span class="discography-grid__title">{entry.title}</span>
              {entry.date ? <span class="discography-grid__date">{entry.date}</span> : null}
            </span>
          </Tag>
        );
      })}
    </div>
  ) : (
    <p class="discography-empty">{emptyMessage}</p>
  )
}

{
  entries.length > 0 ? (
    <noscript>
      <style>
        .discography-grid__img {
          filter: none;
          transform: none;
          opacity: 1;
        }
      </style>
    </noscript>
  ) : null
}

<script>
  function markJacketReady(img: HTMLImageElement) {
    img.classList.add('is-ready');
  }

  function revealJacket(img: HTMLImageElement) {
    if (typeof img.decode === 'function') {
      void img.decode().then(() => markJacketReady(img)).catch(() => markJacketReady(img));
      return;
    }
    markJacketReady(img);
  }

  function armJacket(img: HTMLImageElement) {
    if (img.classList.contains('is-ready')) return;

    if (img.complete && img.naturalWidth > 0) {
      revealJacket(img);
      return;
    }

    img.addEventListener('load', () => revealJacket(img), { once: true });
    img.addEventListener('error', () => markJacketReady(img), { once: true });
  }

  document.querySelectorAll<HTMLImageElement>('.discography-grid__img').forEach(armJacket);
</script>

<style>
  .discography-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1rem;
  }

  .discography-grid__item {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  .discography-grid__item:hover {
    text-decoration: none;
  }

  .discography-grid__art {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 0;
    background: transparent;
    contain: paint;
  }

  .discography-grid__img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: blur(28px) saturate(1.05);
    transform: scale(1.14);
    opacity: 0.92;
    transition:
      filter 0.45s ease,
      transform 0.45s ease,
      opacity 0.4s ease;
  }

  .discography-grid__img.is-ready {
    filter: none;
    transform: none;
    opacity: 1;
  }

  .discography-grid__meta {
    display: grid;
    gap: 0.15rem;
  }

  .discography-grid__title {
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .discography-grid__date {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .discography-empty {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .discography-grid__img {
      filter: none;
      transform: none;
      opacity: 1;
      transition: none;
    }
  }
</style>
