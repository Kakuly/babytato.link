---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'works'>;
}

const { entry } = Astro.props;
const { title, date, type, url, emoji } = entry.data;

const typeLabels: Record<CollectionEntry<'works'>['data']['type'], string> = {
  cover: 'Cover',
  original: 'Original',
  collab: 'Collab',
  live: 'Live',
};

const typeClasses: Record<CollectionEntry<'works'>['data']['type'], string> = {
  cover: 'tag--blue',
  original: 'tag--pink',
  collab: 'tag--purple',
  live: 'tag--green',
};

const formattedDate = date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="work-card bubble-card">
  <a class="work-card__link" href={url} target="_blank" rel="noopener noreferrer">
    <div class="work-card__emoji" aria-hidden="true">{emoji}</div>
    <div class="work-card__body">
      <div class="work-card__meta">
        <span class={`tag ${typeClasses[type]}`}>{typeLabels[type]}</span>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </div>
      <h3 class="work-card__title">{title}</h3>
      <span class="work-card__cta">視聴する ↗</span>
    </div>
  </a>
</article>

<style>
  .work-card {
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .work-card__link {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.25rem;
    text-decoration: none;
  }

  .work-card__emoji {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: 3px solid var(--pop-border);
    border-radius: 1rem;
    background: var(--pop-yellow);
    font-size: 1.75rem;
    box-shadow: var(--shadow-pop);
  }

  .work-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.85rem;
    color: var(--pop-muted);
  }

  .work-card__title {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .work-card__cta {
    font-weight: 700;
    color: var(--pop-purple);
  }
</style>
