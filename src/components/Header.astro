---
import { site } from '../data/site';

const navItems = [
  { href: '/', label: 'HOME' },
  { href: '/#discography', label: 'DISCOGRAPHY' },
  { href: '/#contact', label: 'CONTACT' },
];

const currentPath = Astro.url.pathname;
const isPublicHome = currentPath === '/' || currentPath === '';
---

<header class="header">
  <div class="header__inner">
    <a class="logo" href="/">{site.name}</a>
    <nav class="nav" aria-label="メインナビゲーション">
      {
        navItems.map((item) => {
          const isActive = isPublicHome && item.href === '/';
          return (
            <a
              class:list={['nav__link', { 'nav__link--active': isActive }]}
              href={item.href}
              data-nav-hash={item.href.startsWith('/#') ? item.href.slice(2) : ''}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var links = document.querySelectorAll('.nav__link');
    if (!links.length) return;

    function syncNav() {
      var hash = (window.location.hash || '').replace(/^#/, '');
      links.forEach(function (link) {
        var target = link.getAttribute('data-nav-hash') || '';
        var active = hash ? target === hash : !target;
        link.classList.toggle('nav__link--active', active);
      });
    }

    syncNav();
    window.addEventListener('hashchange', syncNav);
  })();
</script>

<style>
  .header {
    border-bottom: 2px solid var(--line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem 1.35rem;
  }

  .logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    text-decoration: none;
    color: transparent;
    -webkit-text-stroke: 1px var(--ink);
  }

  .logo:hover {
    color: var(--ink);
    -webkit-text-stroke: 0;
    text-decoration: none;
  }

  .nav {
    display: flex;
    gap: 1.1rem;
  }

  .nav__link {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav__link--active,
  .nav__link:hover {
    color: var(--ink);
    text-decoration: none;
  }
</style>
