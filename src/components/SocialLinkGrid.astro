---
import type { SocialLink, SocialPlatform } from '../data/links';
import { socialLinks } from '../data/links';

interface Props {
  links?: SocialLink[];
  class?: string;
}

const { links = socialLinks, class: className } = Astro.props;

function renderIcon(id: SocialPlatform) {
  switch (id) {
    case 'x':
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`;
    case 'youtube':
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`;
    case 'niconico':
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm2 4v8h2.2l3.3-4.8V16H14V8h-2.2L8.5 12.8V8H6zm8 0v8h2V8h-2z"/></svg>`;
    case 'soundcloud':
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 13.5c-.28 0-.5.22-.5.5v2c0 .28.22.5.5.5h.5v-3h-.5zm1.5-.5c-.28 0-.5.22-.5.5v3c0 .28.22.5.5.5h.5v-4h-.5zm1.5-1c-.28 0-.5.22-.5.5v5c0 .28.22.5.5.5h.5v-6h-.5zm1.5-1.5c-.28 0-.5.22-.5.5v7c0 .28.22.5.5.5h.5v-8h-.5zm1.5-2c-.28 0-.5.22-.5.5v9c0 .28.22.5.5.5h.5v-10h-.5zm2-1.5c-.28 0-.5.22-.5.5v11c0 .28.22.5.5.5h.5v-12h-.5zm2-2c-.28 0-.5.22-.5.5v13c0 .28.22.5.5.5h.5v-14h-.5zm2.5-1.5c-.28 0-.5.22-.5.5v15c0 .28.22.5.5.5h.5v-16h-.5zm3-1c-.28 0-.5.22-.5.5v17c0 .28.22.5.5.5h.5v-18h-.5zm3.5-.5c-.28 0-.5.22-.5.5v18c0 .28.22.5.5.5H24v-19h-1.5z"/></svg>`;
    case 'spotify':
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.47 17.27a.75.75 0 0 1-1.03.26c-2.83-1.73-6.39-2.12-10.59-1.16a.75.75 0 1 1-.33-1.46c4.57-1.04 8.52-.6 11.7 1.35a.75.75 0 0 1 .25 1.01zm1.47-3.25a.94.94 0 0 1-1.29.32c-3.24-1.98-8.18-2.55-12.01-1.4a.94.94 0 1 1-.55-1.8c4.38-1.27 9.86-.63 13.6 1.66a.94.94 0 0 1 .25 1.22zm.13-3.39C14.86 8.59 8.6 8.38 5.05 9.58a1.12 1.12 0 1 1-.65-2.15c4.12-1.26 11.04-1.02 15.1 1.87a1.12 1.12 0 0 1-1.2 1.93z"/></svg>`;
    case 'appleMusic':
      return `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>`;
  }
}
---

<nav class:list={['social-grid', className]} aria-label="SNS links">
  {
    links.map((link) => (
      <a
        class="social-grid__item"
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="social-grid__icon" set:html={renderIcon(link.id)} />
        <span class="social-grid__label">{link.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .social-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    padding: 0.85rem 0.75rem;
  }

  .social-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 4.35rem;
    padding: 0.65rem 0.45rem;
    border: 2px solid var(--line);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .social-grid__item:hover {
    background: var(--ink);
    color: var(--void);
    text-decoration: none;
  }

  .social-grid__icon {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
  }

  .social-grid__icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .social-grid__label {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
  }
</style>
