---
import type { SocialLink } from '../data/links';
import { socialLinks } from '../data/links';
import { socialIconSvg } from '../lib/social-icons';

interface Props {
  links?: SocialLink[];
  class?: string;
}

const { links = socialLinks, class: className } = Astro.props;
---

<nav class:list={['social-grid', className]} aria-label="SNS links">
  {
    links.map((link) => (
      <a
        class="social-grid__item"
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="social-grid__icon" set:html={socialIconSvg(link.id)} />
        <span class="social-grid__label">{link.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .social-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: auto;
    align-content: start;
    align-items: start;
    gap: 0.6rem;
    padding: 0.85rem 0.75rem;
  }

  .social-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    align-self: start;
    gap: 0.4rem;
    width: 100%;
    height: auto;
    min-height: 4.35rem;
    padding: 0.65rem 0.45rem;
    border: 2px solid var(--line);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .social-grid__item:hover {
    background: var(--ink);
    color: var(--void);
    text-decoration: none;
  }

  .social-grid__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    aspect-ratio: 1;
  }

  .social-grid__icon :global(svg) {
    display: block;
    width: 1.35rem;
    height: 1.35rem;
    aspect-ratio: 1;
    max-width: 100%;
    max-height: 100%;
    fill: currentColor;
    overflow: visible;
  }

  .social-grid__label {
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
  }
</style>
