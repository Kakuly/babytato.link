---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { title, date, summary, emoji } = entry.data;
const formattedDate = date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="news-card bubble-card">
  <a class="news-card__link" href={`/news/${entry.slug}/`}>
    <div class="news-card__top">
      <span class="tag tag--pink">{emoji} News</span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>
    <h3 class="news-card__title">{title}</h3>
    {summary && <p class="news-card__summary">{summary}</p>}
    <span class="news-card__more">続きを読む →</span>
  </a>
</article>

<style>
  .news-card {
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .news-card__link {
    display: block;
    padding: 1.25rem;
    text-decoration: none;
  }

  .news-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--pop-muted);
  }

  .news-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
  }

  .news-card__summary {
    margin: 0 0 1rem;
    color: var(--pop-muted);
  }

  .news-card__more {
    font-weight: 700;
    color: var(--pop-purple);
  }
</style>
